# ── Amazon Bedrock（LLM 與 embedding）
# 不使用 API key：ECS 上由 task role 提供憑證，本機使用 `aws configure sso` / AWS_PROFILE。
AWS_REGION=ap-northeast-1
# 模型 ID 以你帳號在 Bedrock 開通的為準；Claude 建議使用 APAC inference profile ID（apac.anthropic....）
BEDROCK_CHAT_MODEL_ID=            # 主要對話模型（必填）例如 Claude Sonnet
BEDROCK_MINI_MODEL_ID=            # 輕量模型（router／單課問答）；留空則沿用主要模型，例如 Claude Haiku
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIM=1024        # Titan V2 僅支援 256 / 512 / 1024；改動後 Qdrant 必須重建

# 監控頁費用估算（USD / 百萬 token，選填；預設為遷移前的估算值，請依所選 Bedrock 模型的官方價目覆寫）
# COURSE_PRICE_INPUT_PER_M=  COURSE_PRICE_OUTPUT_PER_M=
# PDF_AGENT_PRICE_INPUT_PER_M=  PDF_AGENT_PRICE_OUTPUT_PER_M=
# PDF_ROUTER_PRICE_INPUT_PER_M=  PDF_ROUTER_PRICE_OUTPUT_PER_M=

# ── LangSmith（LLM 監控，選填）
# 官網：https://smith.langchain.com/
# 不填則靜默略過，不影響系統運作
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=ncu-rag-system
LANGSMITH_TRACING=true

# -----------------------------------
# 應用程式設定（保留預設即可）
# -----------------------------------
APP_ENV=development
APP_PORT=8000
DATA_DIR=data
COURSE_JSON_PATH=data/processed/courses.json
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# 比賽展示版：true 時後端拒絕所有可能呼叫模型的請求（只開放瀏覽與示範案例）。本機開發保持 false。
DEMO_MODE=false

# -----------------------------------
# Cloudinary（上傳 PDF 用）
# -----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROJECT_FOLDER=ncu-ai-guidance/data/raw/projects

# PostgreSQL
DATABASE_URL=

# 開發人員 email（/monitor 監控頁面存取控制，多個用逗號分隔）
DEVELOPER_EMAILS=

# Qdrant（向量資料庫）
# 本機開發可留空，會使用 data/processed/qdrant_data。
# 部署到雲端時填 Qdrant Cloud URL / API key。
QDRANT_URL=
QDRANT_API_KEY=

# Firebase Authentication
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# -----------------------------------
# PDF Chat（Multi-agent 問答）
# -----------------------------------
# PDF 問答使用的 Qdrant collection（Titan 重新向量化後的新 collection 名稱；預設 reports）
# PDF_QDRANT_COLLECTION=reports_titan1024

# LangSmith（PDF 問答獨立 project，與課程助理分開追蹤）
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=        # 同 LANGSMITH_API_KEY
LANGCHAIN_PROJECT=ncu-pdf-chat
